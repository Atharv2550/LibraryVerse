# Server Environment
PORT=5000
NODE_ENV=development

# Database Configuration (Required in Production)
MONGO_URI=mongodb://127.0.0.1:27017/bookverse

# Security & Authentication (Required: Must be a strong unique secret)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRE=30d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Storage for Production Media Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
